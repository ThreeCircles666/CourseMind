# Frontend environment variables example
# Copy to frontend/.env and adjust as needed

# API Base URL.
# Leave empty for local Docker/Vite development so requests go through the same-origin /api proxy.
VITE_API_BASE_URL=

# Vite dev-server proxy target. Docker Compose overrides this to http://backend:8000.
VITE_PROXY_TARGET=http://127.0.0.1:8000
