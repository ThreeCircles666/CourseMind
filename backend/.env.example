# Backend environment variables example.
# Copy to backend/.env and adjust. Do NOT commit the real .env.
APP_NAME=courseguard-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://coursemind:coursemind_dev@127.0.0.1:5432/coursemind
JWT_SECRET_KEY=replace-with-a-random-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=coursemind_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# DASHSCOPE_API_KEY=your-api-key-here

# Embedding configuration (uses same DashScope API key)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_TIMEOUT_SECONDS=60.0
EMBEDDING_MAX_RETRIES=3
# Set to false if your proxy blocks DashScope API
EMBEDDING_TRUST_ENV=true

# RAG configuration
RAG_MIN_SIMILARITY=0.3
RAG_CHAT_MODEL=qwen3.8-flash
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_EXCERPT_CHARS=300
