# Backend environment variables example.
# Copy to backend/.env and adjust. Do NOT commit the real .env.

# Application metadata (usually left as defaults).
APP_NAME=courseguard-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins for local frontend dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection (used later; NOT connected on startup).
DATABASE_URL=postgresql+psycopg://courseguard:courseguard_dev@localhost:5432/courseguard

# DashScope API Key for Qwen LLM (required for chat features).
# Set this as a system environment variable, NOT in this file.
# DASHSCOPE_API_KEY=your-api-key-here
