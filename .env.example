# Root-level environment variables example.
# Copy to .env and adjust as needed. Do NOT commit the real .env.
#
# This root file documents shared/default values. Each app also has its own
# .env.example (frontend/.env.example and backend/.env.example).

# ---- Frontend ----
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---- Backend ----
DATABASE_URL=postgresql+psycopg://courseguard:courseguard_dev@localhost:5432/courseguard
